pragma Style_Astronomy;

with Siril_Progress;

package User is

  procedure Execute (The_Startup_Handler     : not null access procedure;
                     The_Exit_Handler        : not null access procedure;
                     The_Termination_Handler : not null access procedure);

  procedure Show (Message : String);

  procedure Show_Error (Message : String);

  procedure Show_Progress (Item    : String;
                           Percent : Siril_Progress.Percent);

end User;
