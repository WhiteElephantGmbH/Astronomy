pragma Style_Astronomy;

package body Image is

  function Work_Directory return String is ("D:\Pictures\Viewer");

  function Picture_Name return String is ("Picture");

  function Fits_Name return String is (Picture_Name & ".fit");

  function Fits_Filename return String is (Work_Directory & '\' & Fits_Name);

  function Jpec_Filename return String is (Work_Directory & '\' & Picture_Name & ".jpg");

end Image;
